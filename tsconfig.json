{
	"compilerOptions": {
		"target": "ES2021",
		"outDir": "./scripts/",
		"rootDir": "./",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
	  "module": "ESNext",
	  "moduleResolution": "bundler",
	  "resolveJsonModule": true,
	  "incremental": true,
			"tsBuildInfoFile" : "./scripts/.tsbuildinfo"
	}
}
